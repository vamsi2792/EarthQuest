# Copy to .env. Every value is optional; the app runs without any of them.

# Real Claude replies (otherwise the server streams a mock reply)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Defaults match docker-compose.yml
# DATABASE_URL=postgres://earthquest:earthquest@localhost:5440/earthquest

# Error reporting (disabled when empty)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Web app -> server
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WS_URL=ws://localhost:4000/party

# Mobile app -> server (10.0.2.2 reaches the host from an Android emulator; use your LAN IP on a device)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
